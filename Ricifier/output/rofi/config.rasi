// Generated by ricifier. Review before using.

configuration {
  font: "monospace 11";
}

* {
  bg: #635517;
  fg: #efe3d7;
  selected: #d3b7bc;
  accent: #b39f31;
  seltext: #000000;
  selected-active: #b39f31;
  urgent: #d3b7bc;
  placeholder: #897221;
  children: #efe3d7;
}

window {
  background-color: @bg;
  border: 1px;
  border-color: @accent;
  border-radius: 4px;
  padding: 12px;
}

mainbox {
  background-color: @bg;
  spacing: 8px;
  padding: 0;
}

inputbar {
  background-color: @bg;
  text-color: @fg;
  spacing: 8px;
  padding: 0;
}

listview {
  background-color: @bg;
  spacing: 8px;
  padding: 0;
  columns: 1;
  lines: 8;
}

element {
  text-color: @fg;
  background-color: @bg;
  padding: 12px;
  border-radius: 4px;
}

element selected.normal {
  background-color: @selected;
  text-color: @seltext;
  border-radius: 4px;
}

element selected.active {
  background-color: @selected-active;
  text-color: @seltext;
  border-radius: 4px;
}

element urgent {
  background-color: @urgent;
  text-color: @seltext;
}

entry {
  text-color: @fg;
}

prompt {
  text-color: @accent;
}
