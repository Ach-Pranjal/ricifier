// Generated by ricifier. Review before using.

configuration {
  font: "monospace 11";
}

* {
  bg: #862e2e;
  fg: #8ec2ec;
  selected: #f57272;
  accent: #64abe6;
  seltext: #ffffff;
  selected-active: #64abe6;
  urgent: #f57272;
  placeholder: #562526;
  children: #8ec2ec;
}

window {
  background-color: @bg;
  border: 2px;
  border-color: @accent;
  border-radius: 4px;
  padding: 12px;
}

mainbox {
  background-color: @bg;
  spacing: 8px;
  padding: 0;
}

inputbar {
  background-color: @bg;
  text-color: @fg;
  spacing: 8px;
  padding: 0;
}

listview {
  background-color: @bg;
  spacing: 8px;
  padding: 0;
  columns: 1;
  lines: 8;
}

element {
  text-color: @fg;
  background-color: @bg;
  padding: 12px;
  border-radius: 4px;
}

element selected.normal {
  background-color: @selected;
  text-color: @seltext;
  border-radius: 4px;
}

element selected.active {
  background-color: @selected-active;
  text-color: @seltext;
  border-radius: 4px;
}

element urgent {
  background-color: @urgent;
  text-color: @seltext;
}

entry {
  text-color: @fg;
}

prompt {
  text-color: @accent;
}
